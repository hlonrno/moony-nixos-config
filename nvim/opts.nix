{
  termguicolors = true;
  backup = false;
  writebackup = false;
  swapfile = false;
  conceallevel = 0; # none
  fileencoding = "utf-8";
  ignorecase = true;
  smartcase = true;
  wrap = false;
  colorcolumn = [ 80 ];
  showmode = false;

  expandtab = false;
  virtualedit = "all";
  showtabline = 0; # never
  smartindent = true;
  smarttab = true;
  softtabstop = 0;
  tabstop = 4;
  shiftwidth = 4;

  number = true;
  relativenumber = true;
  signcolumn = "yes";
}
